{
  "expo": {
    "name": "HobbyTree",
    "slug": "hobbytree",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.hobbytree"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D530E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.hobbytree"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 사진으로 쓸 사진을 고르기 위해 사진 보관함에 접근해요. 고른 사진만 프로필에 쓰이고, 추천에는 쓰지 않아요.",
          "cameraPermission": "프로필 사진을 바로 찍기 위해 카메라를 사용해요. 찍은 사진은 프로필에만 쓰여요.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "현재 위치로 활동 지역(시·구)을 정하고, 가까운 클래스·체험 장소를 보여 드리기 위해 사용해요."
        }
      ],
      "expo-web-browser"
    ],
    "scheme": "hobbytree",
    "experiments": {
      "typedRoutes": false
    }
  }
}

# HobbyTree 앱 환경 변수 예시
# 이 파일을 복사해 `.env.local`로 만들고 값을 채우세요. (.env.local 은 Git에 올라가지 않아요)
# 값을 바꾼 뒤에는 `npx expo start -c` 로 다시 실행해야 반영돼요.

# 백엔드 주소 — 비워 두면 공용 주소 https://api.hobbytreeapp.com 을 써요.
# 지금은 AWS 최신화 중이라 '로컬 백엔드'로 연동해요 (노션 연동 안내):
#   백엔드를 띄운 PC의 IP를 적으세요. 휴대폰에서 localhost 는 휴대폰 자신이라 안 돼요.
#   PC IP 확인: Windows → PowerShell에서 ipconfig → 'IPv4 주소'
EXPO_PUBLIC_API_URL=http://192.168.0.10:8080

# (선택) 소셜 SDK 연결 전, 개발 모드에서 백엔드 로그인을 시험할 때만 사용
# 카카오 Access Token / 구글 ID Token 을 직접 붙여 넣으면 그 토큰으로 API-01을 호출해요.
# EXPO_PUBLIC_DEV_KAKAO_TOKEN=
# EXPO_PUBLIC_DEV_GOOGLE_TOKEN=

# ── 소셜 로그인 SDK (개발용 빌드: npx expo run:android) ──
# 키를 넣거나 바꾼 뒤에는 npx expo prebuild --clean 후 다시 빌드해야 반영돼요.
# 카카오 개발자 콘솔 → 내 애플리케이션(HobbyTree) → 앱 키 → '네이티브 앱 키'
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
# Google Cloud 콘솔 → 사용자 인증 정보 → '웹 애플리케이션' 클라이언트 ID (Android 클라이언트 ID 아님)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# (iOS 빌드할 때만) iOS 클라이언트 ID를 뒤집은 값 예) com.googleusercontent.apps.xxxx
# EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
